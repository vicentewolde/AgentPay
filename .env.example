# Copy to .env.local — never commit .env.local.
# `pnpm run bootstrap` (T2) generates and funds the keypairs and writes the file
# for you; `pnpm run deploy:registry` (T6) fills in the contract id.

STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Registry admin — owns register_issuer / deactivate_issuer.
ADMIN_PUBLIC_KEY=
ADMIN_SECRET_KEY=

# Principal that issues AgentPass credentials and anchors their hashes.
ISSUER_PUBLIC_KEY=
ISSUER_SECRET_KEY=

# The agent the demo credential is issued to.
AGENT_PUBLIC_KEY=
AGENT_SECRET_KEY=

# Written by deploy:registry.
AGENT_REGISTRY_CONTRACT_ID=
